// Prisma Schema for FlipGyan Educational Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum Board {
  CBSE
  ICSE
  STATE
}

enum QuestionType {
  MCQ
  MULTIPLE_CORRECT
  FILL_IN_BLANK
  TRUE_FALSE
  ASSERTION_REASON
  MATCH_FOLLOWING

  VERY_SHORT_ANSWER
  SHORT_ANSWER
  LONG_ANSWER

  CASE_BASED
  SOURCE_BASED
  PASSAGE_BASED
  DATA_BASED

  PICTURE_BASED
  DIAGRAM_BASED
  MAP_BASED
  GRAPH_BASED

  NUMERICAL
  APPLICATION_BASED
  HOTS
  ANALYTICAL

  CREATIVE_WRITING
  GRAMMAR
  READING_COMPREHENSION
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
  VERY_HARD
  OLYMPIAD
}

enum CognitiveLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

enum QuestionStatus {
  DRAFT
  REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum Language {
  ENGLISH
  HINDI
  BILINGUAL
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  REVIEWER
  STUDENT
  PARENT
  CONTENT_EDITOR
}

//////////////////////////////////////////////////////
// SCHOOL
//////////////////////////////////////////////////////

model School {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  city        String?
  state       String?
  board       Board?
  isActive    Boolean  @default(true)

  users       User[]
  sessions    AcademicSession[]
  classes     Class[]
  subjects    Subject[]
  questions   Question[]
  blueprints  Blueprint[]
  papers      QuestionPaper[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id           String    @id @default(uuid())

  schoolId     String?
  schoolRef    School?   @relation(fields: [schoolId], references: [id])

  name         String
  email        String    @unique
  passwordHash String?
  password     String?

  role         String    @default("TEACHER")
  userRole     UserRole?
  avatar       String?
  phone        String?
  classGradeId String?
  school       String?
  parentId     String?
  streakDays   Int       @default(1)
  totalXp      Int       @default(0)
  level        Int       @default(1)
  lastActiveAt DateTime? @default(now())

  classGrade       ClassGrade?         @relation(fields: [classGradeId], references: [id], onDelete: SetNull)
  parent           User?               @relation("ParentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children         User[]              @relation("ParentChildren")
  createdQuestions Question[]          @relation("CreatedQuestions")

  quizAttempts       QuizAttempt[]
  worksheetAttempts  WorksheetAttempt[]
  bookmarks          Bookmark[]
  userAchievements   UserAchievement[]
  learningActivities LearningActivity[]
  studentAssignments StudentAssignment[]
  createdAssignments Assignment[]        @relation("TeacherAssignments")
  createdWorksheets  Worksheet[]         @relation("TeacherWorksheets")
  createdQuizzes     Quiz[]              @relation("TeacherQuizzes")
  createdPapers      QuestionPaper[]     @relation("TeacherPapers")
  subscriptions      Subscription[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

//////////////////////////////////////////////////////
// ACADEMIC SESSION
//////////////////////////////////////////////////////

model AcademicSession {
  id          String   @id @default(uuid())

  schoolId    String
  school      School @relation(fields: [schoolId], references: [id])

  name        String
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean @default(false)

  questions   Question[]

  createdAt   DateTime @default(now())
}

//////////////////////////////////////////////////////
// CLASS
//////////////////////////////////////////////////////

model Class {
  id          String @id @default(uuid())

  schoolId    String
  school      School @relation(fields: [schoolId], references: [id])

  name        String
  classNo     Int

  subjects    Subject[]
  questions   Question[]

  @@unique([schoolId, classNo])
}

model ClassGrade {
  id          String   @id @default(uuid())
  name        String
  number      Int      @unique
  order       Int      @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users          User[]
  subjects       Subject[]
  assignments    Assignment[]
  questionPapers QuestionPaper[]
}

//////////////////////////////////////////////////////
// SUBJECT
//////////////////////////////////////////////////////

model Subject {
  id           String   @id @default(uuid())

  schoolId     String?
  school       School?  @relation(fields: [schoolId], references: [id])

  classId      String?
  class        Class?   @relation(fields: [classId], references: [id])

  classGradeId String?
  classGrade   ClassGrade? @relation(fields: [classGradeId], references: [id], onDelete: Cascade)

  name         String
  code         String
  icon         String?
  color        String?

  chapters       Chapter[]
  questions      Question[]
  worksheets     Worksheet[]
  quizzes        Quiz[]
  assignments    Assignment[]
  questionPapers QuestionPaper[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

//////////////////////////////////////////////////////
// CHAPTER
//////////////////////////////////////////////////////

model Chapter {
  id              String @id @default(uuid())

  subjectId       String
  subject         Subject @relation(fields: [subjectId], references: [id])

  name            String  @default("Chapter")
  title           String?
  chapterNo       Int?
  chapterNumber   Int?
  description     String?

  topics          Topic[]
  questions       Question[]
  studyNotes      StudyNote[]
  worksheets      Worksheet[]
  quizzes         Quiz[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

//////////////////////////////////////////////////////
// TOPIC
//////////////////////////////////////////////////////

model Topic {
  id          String @id @default(uuid())

  chapterId   String
  chapter     Chapter @relation(fields: [chapterId], references: [id])

  name        String  @default("Topic")
  title       String?
  order       Int     @default(1)
  summary     String?

  questions   Question[]
  studyNotes  StudyNote[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

//////////////////////////////////////////////////////
// LEARNING OUTCOME
//////////////////////////////////////////////////////

model LearningOutcome {
  id          String @id @default(uuid())

  code        String
  description String

  questions   QuestionLearningOutcome[]
}

model QuestionLearningOutcome {
  questionId          String
  learningOutcomeId   String

  question            Question @relation(fields: [questionId], references: [id])
  learningOutcome     LearningOutcome @relation(fields: [learningOutcomeId], references: [id])

  @@id([questionId, learningOutcomeId])
}

//////////////////////////////////////////////////////
// QUESTION
//////////////////////////////////////////////////////

model Question {

  id              String @id @default(uuid())

  schoolId        String?
  school          School? @relation(fields: [schoolId], references: [id])

  questionCode    String? @unique

  board           Board @default(CBSE)

  classId         String?
  class           Class? @relation(fields: [classId], references: [id])

  subjectId       String?
  subject         Subject? @relation(fields: [subjectId], references: [id])

  chapterId       String?
  chapter         Chapter? @relation(fields: [chapterId], references: [id])

  topicId         String?
  topic           Topic? @relation(fields: [topicId], references: [id])

  sessionId       String?
  session         AcademicSession? @relation(fields: [sessionId], references: [id])

  type            String?  @default("MCQ")
  questionType    String   @default("MCQ")
  enumType        QuestionType?

  questionText    String
  questionHindi   String?

  questionData    Json?

  difficulty      String   @default("MEDIUM")
  enumDifficulty  DifficultyLevel?

  bloomLevel      String?  @default("UNDERSTAND")
  cognitiveLevel  CognitiveLevel?

  competency      String?  @default("CONCEPTUAL")

  competencyBased Boolean  @default(false)

  hots            Boolean  @default(false)

  marks           Int      @default(1)

  negativeMarks   Float    @default(0)

  explanation     String?
  hint            String?
  answerText      String?

  language        Language @default(ENGLISH)

  status          QuestionStatus @default(DRAFT)

  createdById     String?
  createdBy       User? @relation("CreatedQuestions", fields: [createdById], references: [id])

  options         QuestionOption[]
  rubrics         QuestionRubric[]
  media           QuestionMedia[]
  versions        QuestionVersion[]

  learningOutcomes QuestionLearningOutcome[]

  paperQuestions     PaperQuestion[]
  worksheetQuestions WorksheetQuestion[]
  quizQuestions      QuizQuestion[]

  questionHash    String?

  aiGenerated     Boolean @default(false)

  aiMetadata      Json?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([classId])
  @@index([subjectId])
  @@index([chapterId])

  @@index([questionType])

  @@index([difficulty])

  @@index([status])

  @@index([schoolId, classId, subjectId, chapterId, questionType, difficulty, status])
}

model QuestionVersion {
  id            String   @id @default(uuid())
  questionId    String
  versionNumber Int
  questionText  String
  questionData  String
  changeReason  String?
  createdById   String?
  createdAt     DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////
// OPTIONS
//////////////////////////////////////////////////////

model QuestionOption {

  id              String @id @default(uuid())

  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  optionKey       String?  @default("A")
  optionLabel     String?
  optionText      String?
  text            String?
  optionHindi     String?

  isCorrect       Boolean @default(false)

  displayOrder    Int @default(1)
  sequence        Int @default(1)

  explanation     String?
}

//////////////////////////////////////////////////////
// RUBRICS
//////////////////////////////////////////////////////

model QuestionRubric {

  id              String @id @default(uuid())

  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  criterion       String

  expectedAnswer  String?

  marks           Decimal @db.Decimal(5,2)

  displayOrder    Int @default(1)
}

//////////////////////////////////////////////////////
// MEDIA
//////////////////////////////////////////////////////

model QuestionMedia {

  id              String @id @default(uuid())

  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  mediaType       String

  fileUrl         String

  caption         String?

  displayOrder    Int @default(1)
}

//////////////////////////////////////////////////////
// BLUEPRINT
//////////////////////////////////////////////////////

model Blueprint {

  id              String @id @default(uuid())

  schoolId        String?
  school          School? @relation(fields: [schoolId], references: [id])

  name            String

  totalMarks      Int

  durationMinutes Int

  papers          QuestionPaper[]
}

//////////////////////////////////////////////////////
// QUESTION PAPER
//////////////////////////////////////////////////////

model QuestionPaper {

  id              String   @id @default(uuid())

  schoolId        String?
  school          School?  @relation(fields: [schoolId], references: [id])

  blueprintId     String?
  blueprint       Blueprint? @relation(fields: [blueprintId], references: [id])

  title           String
  examName        String   @default("Term 1 Final Examination")
  academicYear    String   @default("2026-2027")

  classGradeId    String?
  subjectId       String?

  classGrade      ClassGrade? @relation(fields: [classGradeId], references: [id], onDelete: SetNull)
  subject         Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  totalMarks      Int      @default(80)
  durationMinutes Int      @default(180)
  instructions    String?
  blueprintJson   String?
  sectionsJson    String?

  setCode         String?

  createdById     String?
  createdBy       User?    @relation("TeacherPapers", fields: [createdById], references: [id])

  questions       PaperQuestion[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

//////////////////////////////////////////////////////
// PAPER QUESTIONS
//////////////////////////////////////////////////////

model PaperQuestion {

  id              String @id @default(uuid())

  paperId         String
  paper           QuestionPaper @relation(fields: [paperId], references: [id])

  questionId      String
  question        Question @relation(fields: [questionId], references: [id])

  questionNo      String

  marks           Decimal @db.Decimal(5,2)

  displayOrder    Int
}

//////////////////////////////////////////////////////
// STUDENT & LEARNING EXTENSIONS
//////////////////////////////////////////////////////

model StudyNote {
  id                 String   @id @default(uuid())
  title              String
  summary            String
  keyConcepts        String
  definitions        String
  examples           String
  importantPoints    String
  mindMapJson        String?
  visualExplanation  String?
  deepDive           String?
  practiceQuestions  String?
  chapterId          String
  topicId            String?
  viewsCount         Int      @default(0)
  isPublished        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)
}

model Worksheet {
  id              String   @id @default(uuid())
  title           String
  description     String?
  instructions    String?
  type            String   @default("PRACTICE")
  difficulty      String   @default("MEDIUM")
  durationMinutes Int      @default(30)
  totalMarks      Int      @default(20)
  totalQuestions  Int      @default(10)
  pdfUrl          String?
  answerKey       String?
  chapterId       String
  subjectId       String
  createdById     String?
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  chapter     Chapter             @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  subject     Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdBy   User?               @relation("TeacherWorksheets", fields: [createdById], references: [id], onDelete: SetNull)
  questions   WorksheetQuestion[]
  attempts    WorksheetAttempt[]
  assignments Assignment[]
}

model WorksheetQuestion {
  id          String @id @default(uuid())
  worksheetId String
  questionId  String
  sequence    Int    @default(1)
  marks       Int    @default(1)

  worksheet Worksheet @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  question  Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model WorksheetAttempt {
  id               String   @id @default(uuid())
  worksheetId      String
  userId           String
  score            Float    @default(0)
  totalMarks       Int      @default(20)
  percentage       Float    @default(0)
  timeSpentSeconds Int      @default(0)
  answersJson      String
  submittedAt      DateTime @default(now())
  graded           Boolean  @default(true)

  worksheet Worksheet @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Quiz {
  id              String   @id @default(uuid())
  title           String
  description     String?
  durationMinutes Int      @default(15)
  totalMarks      Int      @default(10)
  passMarks       Int      @default(5)
  difficulty      String   @default("MEDIUM")
  chapterId       String
  subjectId       String
  createdById     String?
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  chapter     Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdBy   User?          @relation("TeacherQuizzes", fields: [createdById], references: [id], onDelete: SetNull)
  questions   QuizQuestion[]
  attempts    QuizAttempt[]
  assignments Assignment[]
}

model QuizQuestion {
  id         String @id @default(uuid())
  quizId     String
  questionId String
  sequence   Int    @default(1)

  quiz     Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id               String   @id @default(uuid())
  quizId           String
  userId           String
  score            Float    @default(0)
  maxScore         Float    @default(10)
  percentage       Float    @default(0)
  correctCount     Int      @default(0)
  incorrectCount   Int      @default(0)
  skippedCount     Int      @default(0)
  timeSpentSeconds Int      @default(0)
  answersJson      String
  completedAt      DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Bookmark {
  id           String   @id @default(uuid())
  userId       String
  itemType     String
  itemId       String
  title        String
  subtitle     String?
  metadataJson String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
}

model Achievement {
  id             String   @id @default(uuid())
  code           String   @unique
  title          String
  description    String
  icon           String
  badgeType      String
  xpReward       Int      @default(50)
  conditionType  String
  conditionValue Int      @default(1)

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model Assignment {
  id           String    @id @default(uuid())
  teacherId    String
  classGradeId String?
  subjectId    String
  worksheetId  String?
  quizId       String?
  title        String
  instructions String?
  dueDate      DateTime?
  createdAt    DateTime  @default(now())

  teacher            User                @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  classGrade         ClassGrade?         @relation(fields: [classGradeId], references: [id], onDelete: Cascade)
  subject            Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  worksheet          Worksheet?          @relation(fields: [worksheetId], references: [id], onDelete: SetNull)
  quiz               Quiz?               @relation(fields: [quizId], references: [id], onDelete: SetNull)
  studentAssignments StudentAssignment[]
}

model StudentAssignment {
  id           String    @id @default(uuid())
  assignmentId String
  studentId    String
  status       String    @default("PENDING")
  score        Float?
  submittedAt  DateTime?
  feedback     String?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model Subscription {
  id         String   @id @default(uuid())
  userId     String
  planName   String
  status     String   @default("ACTIVE")
  startDate  DateTime @default(now())
  endDate    DateTime
  amountPaid Float    @default(0)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LearningActivity {
  id           String   @id @default(uuid())
  userId       String
  activityType String
  description  String
  xpEarned     Int      @default(0)
  metadataJson String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////
// QUESTION TYPE MASTER
//////////////////////////////////////////////////////

model QuestionTypeMaster {
  id              String   @id @default(uuid())

  code            String   @unique
  name            String
  category        String
  description     String?

  defaultMarks    Decimal? @db.Decimal(5,2)

  isObjective     Boolean  @default(false)
  isSubjective    Boolean  @default(false)
  isCompetency    Boolean  @default(false)

  active          Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
