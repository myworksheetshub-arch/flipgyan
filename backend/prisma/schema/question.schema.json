{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://flipgyan.com/schemas/question.schema.json",
    "title": "FlipGyan Question Bank Schema",
    "description": "Schema for FlipGyan educational question bank data",
    "type": "object",
    "required": [
        "board",
        "class",
        "subject",
        "chapter",
        "questions"
    ],
    "properties": {
        "board": {
            "type": "string",
            "enum": [
                "CBSE",
                "ICSE",
                "UP_BOARD",
                "STATE_BOARD"
            ]
        },
        "class": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
        },
        "subject": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
        },
        "chapter": {
            "$ref": "#/$defs/chapter"
        },
        "questions": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/question"
            }
        }
    },
    "$defs": {
        "chapter": {
            "type": "object",
            "required": [
                "number",
                "name"
            ],
            "properties": {
                "number": {
                    "type": "integer",
                    "minimum": 1
                },
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                }
            },
            "additionalProperties": false
        },
        "question": {
            "type": "object",
            "required": [
                "id",
                "type",
                "difficulty",
                "question",
                "answer"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[A-Z0-9-]+$",
                    "minLength": 5,
                    "maxLength": 100
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "MCQ",
                        "FILL_BLANK",
                        "TRUE_FALSE",
                        "MATCH",
                        "SHORT_ANSWER",
                        "LONG_ANSWER",
                        "ASSERTION_REASON",
                        "CASE_BASED",
                        "HOTS",
                        "NUMERICAL",
                        "VERY_SHORT_ANSWER"
                    ]
                },
                "difficulty": {
                    "type": "string",
                    "enum": [
                        "Easy",
                        "Medium",
                        "Hard",
                        "Olympiad"
                    ]
                },
                "question": {
                    "type": "string",
                    "minLength": 1
                },
                "options": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 6,
                    "items": {
                        "$ref": "#/$defs/option"
                    }
                },
                "answer": {
                    "type": "string",
                    "minLength": 1
                },
                "explanation": {
                    "type": "string"
                },
                "marks": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 100
                },
                "language": {
                    "type": "string",
                    "enum": [
                        "English",
                        "Hindi",
                        "Bilingual"
                    ],
                    "default": "English"
                },
                "topic": {
                    "type": "string",
                    "maxLength": 200
                },
                "learning_objective": {
                    "type": "string",
                    "maxLength": 500
                },
                "blooms_level": {
                    "type": "string",
                    "enum": [
                        "Remember",
                        "Understand",
                        "Apply",
                        "Analyze",
                        "Evaluate",
                        "Create"
                    ]
                },
                "source": {
                    "type": "string",
                    "enum": [
                        "MANUAL",
                        "AI",
                        "IMPORTED",
                        "SEED"
                    ]
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "DRAFT",
                        "UNDER_REVIEW",
                        "APPROVED",
                        "PUBLISHED",
                        "ARCHIVED"
                    ]
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "media": {
                    "$ref": "#/$defs/media"
                },
                "ai_metadata": {
                    "$ref": "#/$defs/aiMetadata"
                }
            },
            "additionalProperties": false
        },
        "option": {
            "type": "object",
            "required": [
                "id",
                "text"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[A-F]$"
                },
                "text": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": false
        },
        "media": {
            "type": "object",
            "properties": {
                "image": {
                    "type": "string"
                },
                "image_alt": {
                    "type": "string"
                },
                "diagram": {
                    "type": "string"
                },
                "audio": {
                    "type": "string"
                },
                "video": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "aiMetadata": {
            "type": "object",
            "properties": {
                "model": {
                    "type": "string"
                },
                "prompt": {
                    "type": "string"
                },
                "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "generated_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "review_status": {
                    "type": "string",
                    "enum": [
                        "PENDING",
                        "PASSED",
                        "FAILED",
                        "REVIEWED"
                    ]
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}